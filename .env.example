# Copia este archivo a .env (que git ignora) y rellénalo. NUNCA subas .env ni pegues claves en el chat.

# --- Cuenta de despliegue -------------------------------------------------------------
# Usa una cartera NUEVA solo para desplegar, con el ETH justo para gas (≈ 2-5 USD).
# No uses la cartera donde guardas fondos ni la del fundador. Tras desplegar no conserva privilegios.
DEPLOYER_PRIVATE_KEY=

# RPC (opcional; por defecto los públicos de Base)
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# Clave gratuita de https://etherscan.io/apis (Etherscan API V2, válida para Basescan)
ETHERSCAN_API_KEY=

# --- Token ------------------------------------------------------------------------------
TOKEN_NAME=Sensei Herb
TOKEN_SYMBOL=SENSEI
# En tokens enteros (18 decimales se añaden automáticamente)
MAX_SUPPLY=100000000

# --- Asignaciones (puntos básicos: 100 = 1 %, deben sumar 10000) -------------------------
FOUNDER_BPS=3000
COMMUNITY_BPS=3000
TREASURY_BPS=2500
LIQUIDITY_BPS=1500

# Direcciones que controlas TÚ. Recomendado: Safe multisig (https://app.safe.global) para comunidad y tesorería.
FOUNDER_ADDRESS=
COMMUNITY_ADDRESS=
TREASURY_ADDRESS=
# Debe ser la cuenta que firmará la creación del pool (puede ser la misma que DEPLOYER_PRIVATE_KEY).
LIQUIDITY_ADDRESS=

# --- Vesting (meses de 30 días) ----------------------------------------------------------
FOUNDER_CLIFF_MONTHS=12
FOUNDER_VESTING_MONTHS=48
TREASURY_CLIFF_MONTHS=0
# 0 = la tesorería recibe los tokens directamente, sin contrato de vesting
TREASURY_VESTING_MONTHS=24
# Marca de tiempo unix de inicio; vacío = 10 minutos después del bloque actual
VESTING_START=

# --- Liquidez (scripts/add-liquidity.js) -------------------------------------------------
LP_TOKEN_AMOUNT=15000000
LP_ETH_AMOUNT=
LP_SLIPPAGE_BPS=100
# Quién recibe los tokens LP (quien los tenga puede retirar la liquidez). Vacío = la cuenta firmante.
LP_RECIPIENT=
# Solo si la red no está en config/dex.js (p. ej. Base Sepolia)
UNISWAP_V2_ROUTER=
UNISWAP_V2_FACTORY=

# Solo mostrar plan y estimación, sin enviar transacciones
DRY_RUN=false
